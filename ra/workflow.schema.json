{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/recorded-automation/workflow-v1.schema.json",
  "title": "Recorded browser workflow v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "origin", "start_url", "steps"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 60 },
    "origin": { "type": "string", "pattern": "^https?://[^/?#]+$" },
    "start_url": { "type": "string", "format": "uri" },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/step" }
    }
  },
  "$defs": {
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "value"],
      "properties": {
        "strategy": { "enum": ["role", "label", "test_id", "text", "css"] },
        "value": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "strategy": { "const": "role" } } },
          "then": { "required": ["name"] },
          "else": { "not": { "required": ["name"] } }
        }
      ]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["page", "locators"],
      "properties": {
        "page": { "type": "string", "minLength": 1 },
        "frame": { "type": "string", "minLength": 1 },
        "locators": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/locator" }
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "action"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "action": { "enum": ["click", "fill", "hotkey", "wait_for"] },
        "target": { "$ref": "#/$defs/target" },
        "text": { "type": "string" },
        "secret_ref": { "type": "string", "minLength": 1 },
        "hotkey": { "type": "string", "minLength": 1 },
        "expected": { "$ref": "#/$defs/target" },
        "timeout_s": { "type": "number", "exclusiveMinimum": 0 }
      },
      "allOf": [
        {
          "if": { "properties": { "action": { "enum": ["click", "fill", "wait_for"] } } },
          "then": { "required": ["target"] }
        },
        {
          "if": { "properties": { "action": { "const": "fill" } } },
          "then": {
            "oneOf": [
              { "required": ["text"], "not": { "required": ["secret_ref"] } },
              { "required": ["secret_ref"], "not": { "required": ["text"] } }
            ]
          },
          "else": { "not": { "anyOf": [{ "required": ["text"] }, { "required": ["secret_ref"] }] } }
        },
        {
          "if": { "properties": { "action": { "const": "hotkey" } } },
          "then": { "required": ["hotkey"] },
          "else": { "not": { "required": ["hotkey"] } }
        }
      ]
    }
  }
}
