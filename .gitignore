# Python 字节码与打包产物
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/*
dist/
# 打包配置与图标是真实资产，必须入库（build/ 同时是 PyInstaller 的工作目录）
!build/录放台.spec
!build/app.ico

# 封装版的可执行文件是打包产物（约 90MB），用 build/录放台.spec 重新生成
*.exe
*.dll

# 虚拟环境
.venv/
venv/
env/
ENV/

# 本机数据与凭据（工作流、秘密库、日志都在 %LOCALAPPDATA%\RecordedAutomation，不在仓库里）
.env
.env.*
*.local.json

# 运行与自测留下的临时产物
/ms-playwright/
/profile/
/shell-profile/
# .ra-tmp/ 是排查浏览器问题留下的 Chromium 档案，里面有这个账号真实的 Cookies 与 Login Data。
# 它留在磁盘上有用，但绝不能进版本库；根锚定写，裸 `.ra-tmp/` 会连子目录一起放过。
/.ra-tmp/
/exports/
/ui-shots/
/selfcheck/
/selfcheck-report.txt
/verify-report.txt
/startup-error.txt
*.log
agent/.endpoint

# 编辑器与系统垃圾
.idea/
.vscode/
Thumbs.db
Desktop.ini
.DS_Store
